<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simulated tests (mocks) for TESTING.md. Compiles the app's own source, except its entry point.
       Never stops, starts or reconfigures services: only Updater.Install with local file:// URLs
       and MainForm.Apply with made-up reports. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VanguardSwitch</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\*.cs" Exclude="..\..\src\Program.cs" />
    <Compile Include="SimulatedTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
